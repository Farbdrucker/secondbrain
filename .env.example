TELEGRAM_BOT_TOKEN=123456:ABC...
# Only messages from this chat are accepted. Find it via @userinfobot.
TELEGRAM_CHAT_ID=123456789
# Created once with `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Optional
CLAUDE_MODEL=sonnet
# Time zone for dates in file names, index and log
BRAIN_TZ=Europe/Berlin
MAX_ATTEMPTS=3
# Speech-to-text when there are no subtitles: tiny, base, small, medium (slower, better)
WHISPER_MODEL=small
WHISPER_MAX_MINUTES=90
# Optional cookies.txt (Netscape format) for Instagram, path inside the container
# YTDLP_COOKIES=/data/cache/cookies.txt
# A tag gets its own topic page from this many entries on
TOPIC_MIN_ENTRIES=3
# Silent Telegram summary after each nightly run (0 = off)
NOTIFY=1
# Links from these domains are saved without download or LLM, tagged for reading later.
# Web pages that fail to download get the same treatment.
# READ_LATER_DOMAINS=archive.ph,archive.today,archive.is,archive.li,archive.md,archive.vn,archive.fo
# READ_LATER_TAGS=lesen,todo
